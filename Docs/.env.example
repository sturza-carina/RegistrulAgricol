# Google Maps JavaScript API key used by the Angular frontend.
# Get one from https://console.cloud.google.com/google/maps-apis/credentials
# Copy this file to .env and fill in the value. .env is gitignored.
GOOGLE_MAPS_API_KEY=

# Secret key used to sign/verify JWT auth tokens (backend). Required in production
# (application-prod.yml has no fallback and will fail to start without it).
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Postgres credentials used by docker-compose for both the db and backend services.
# Leave unset to fall back to the insecure admin/admin_password dev defaults.
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
